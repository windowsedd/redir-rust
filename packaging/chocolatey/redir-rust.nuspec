<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>redir-rust</id>
    <version>@VERSION@</version>
    <title>redir-rust</title>
    <authors>windowsedd</authors>
    <owners>windowsedd</owners>
    <projectUrl>https://github.com/windowsedd/redir-rust</projectUrl>
    <packageSourceUrl>https://github.com/windowsedd/redir-rust/tree/main/packaging/chocolatey</packageSourceUrl>
    <projectSourceUrl>https://github.com/windowsedd/redir-rust</projectSourceUrl>
    <bugTrackerUrl>https://github.com/windowsedd/redir-rust/issues</bugTrackerUrl>
    <licenseUrl>https://github.com/windowsedd/redir-rust/blob/@TAG@/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <summary>TCP/UDP port redirector with failover and Minecraft offline responses</summary>
    <description>redir-rust forwards TCP and UDP traffic to backend targets. It includes ordered TCP failover, Bedrock UDP failover, Minecraft offline MOTD responses, a terminal menu, and a browser manager. This package contains the Windows x64 portable executable. Run redir-rust to configure redirects; installation does not start a background process.</description>
    <releaseNotes>https://github.com/windowsedd/redir-rust/releases/tag/@TAG@</releaseNotes>
    <tags>redir-rust tcp udp proxy minecraft portable</tags>
    <dependencies>
      <dependency id="vcredist140" version="14.0" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
